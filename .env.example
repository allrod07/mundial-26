# ── API-Football (Modo Automático) ───────────────────────────────────────────
# Crie a conta em https://www.api-football.com/ e copie a chave no Dashboard.
API_FOOTBALL_KEY=
# Host padrão (acesso direto api-sports.io). Para RapidAPI ajuste host + flag:
# API_FOOTBALL_HOST=https://v3.football.api-sports.io
# API_FOOTBALL_VIA_RAPIDAPI=false
# Copa do Mundo: league 1, season 2026 (padrões; só altere se necessário).
# API_FOOTBALL_LEAGUE=1
# API_FOOTBALL_SEASON=2026

# ── Supabase (armazenamento dos resultados sincronizados) ─────────────────────
# Project Settings → API.  As NEXT_PUBLIC_* vão para o navegador (ok, são públicas).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SECRETA, só no servidor (sync). Nunca exponha no front.
SUPABASE_SERVICE_ROLE_KEY=

# ── Proteção da rota de sincronização ─────────────────────────────────────────
# Segredo exigido em POST /api/sync  (header  Authorization: Bearer <SYNC_SECRET>
# ou ?secret=<SYNC_SECRET>). Defina um valor forte em produção.
SYNC_SECRET=

# ── Painel /admin (preenchimento manual dos resultados) ───────────────────────
# Senha do painel /admin. Se não definir, o painel aceita o SYNC_SECRET.
# A escrita manual GRAVA no Supabase, então exige a SUPABASE_SERVICE_ROLE_KEY acima.
ADMIN_PASSWORD=

# (Opcional) Token do Vercel Cron — defina igual ao SYNC_SECRET para o cron autenticar.
CRON_SECRET=
