// Prisma schema — modelo relacional para evolução do Mundial '26 até produção.
// Banco-alvo: PostgreSQL. Espelha o domínio em `lib/types.ts`.
// Gere o client com: npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Confederation {
  UEFA
  CONMEBOL
  CONCACAF
  CAF
  AFC
  OFC
}

enum PositionGroup {
  GOL
  DEF
  MEI
  ATA
}

enum Stage {
  GRUPOS
  R32
  OITAVAS
  QUARTAS
  SEMIFINAL
  TERCEIRO
  FINAL
}

enum MatchStatus {
  AGENDADO
  AO_VIVO
  ENCERRADO
}

enum EventType {
  GOL
  GOL_CONTRA
  PENALTI
  AMARELO
  VERMELHO
  ASSIST
}

model Team {
  id            String        @id @default(cuid())
  code          String        @unique // BRA, ARG...
  name          String
  flagUrl       String
  confederation Confederation
  fifaRank      Int
  rating        Int
  coach         String
  groupLetter   String // A..L
  host          Boolean       @default(false)
  titles        Int           @default(0)
  appearances   Int           @default(0)
  bestResult    String
  nickname      String
  primaryColor  String
  secondaryColor String

  players      Player[]
  homeMatches  Match[]       @relation("HomeTeam")
  awayMatches  Match[]       @relation("AwayTeam")
  standings    Standing[]

  @@index([groupLetter])
  @@index([confederation])
}

model Player {
  id            String        @id @default(cuid())
  team          Team          @relation(fields: [teamId], references: [id])
  teamId        String
  name          String
  number        Int
  position      String
  positionGroup PositionGroup
  birth         DateTime
  height        Int
  weight        Int
  foot          String
  club          String
  clubCountry   String
  caps          Int           @default(0)
  intlGoals     Int           @default(0)
  marketValue   Float         @default(0) // milhões de €
  rating        Int
  isCaptain     Boolean       @default(false)

  events        MatchEvent[]  @relation("EventPlayer")
  assists       MatchEvent[]  @relation("EventAssist")

  @@unique([teamId, number])
  @@index([teamId, positionGroup])
}

model City {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  country  String
  stadium  String
  capacity Int
  matches  Match[]
}

model Match {
  id          String      @id @default(cuid())
  slug        String      @unique // G-A-1-1, R32-1, FINAL...
  stage       Stage
  groupLetter String?
  round       Int? // matchday 1..3 na fase de grupos
  kickoff     DateTime
  city        City        @relation(fields: [cityId], references: [id])
  cityId      String

  homeTeam    Team?       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  homeTeamId  String?
  awayTeam    Team?       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  awayTeamId  String?
  homeLabel   String? // "1º Grupo A" quando indefinido
  awayLabel   String?

  homeGoals   Int?
  awayGoals   Int?
  homePens    Int?
  awayPens    Int?
  status      MatchStatus @default(AGENDADO)
  minute      Int?

  bracketSlot Int?
  events      MatchEvent[]

  @@index([stage])
  @@index([groupLetter, round])
  @@index([kickoff])
}

model MatchEvent {
  id             String    @id @default(cuid())
  match          Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId        String
  minute         Int
  type           EventType
  player         Player    @relation("EventPlayer", fields: [playerId], references: [id])
  playerId       String
  assistPlayer   Player?   @relation("EventAssist", fields: [assistPlayerId], references: [id])
  assistPlayerId String?

  @@index([matchId])
  @@index([playerId])
}

// Cache materializado da classificação (atualizado por job/trigger ao fim de cada jogo).
model Standing {
  id          String @id @default(cuid())
  team        Team   @relation(fields: [teamId], references: [id])
  teamId      String
  groupLetter String
  played      Int    @default(0)
  win         Int    @default(0)
  draw        Int    @default(0)
  loss        Int    @default(0)
  goalsFor    Int    @default(0)
  goalsAgainst Int   @default(0)
  points      Int    @default(0)
  rank        Int    @default(0)

  @@unique([teamId])
  @@index([groupLetter, rank])
}

// Cenários salvos do simulador por usuário (overrides de placar).
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  password  String
  createdAt DateTime   @default(now())
  scenarios Scenario[]
  favorites Favorite[]
}

model Scenario {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  // mapa matchSlug -> { homeGoals, awayGoals, homePens?, awayPens? }
  overrides Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Favorite {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  kind   String // team | match | player
  refId  String

  @@unique([userId, kind, refId])
}
